{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "seed": "medusa exec src/migration-scripts/initial-data-seed.ts",
    "import-products": "medusa exec src/migration-scripts/import-techtonics-products.ts",
    "setup-sidebar": "medusa exec src/migration-scripts/setup-sidebar-layout.ts",
    "clear-data": "medusa exec src/migration-scripts/clear-all-data.ts",
    "clear-customers": "medusa exec src/migration-scripts/clear-customer-data.ts",
    "import-categories": "medusa exec src/migration-scripts/import-scraped-categories.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "postinstall": "node patch_medusa_razorpay.js && node patch_medusa_payment_module.js"
  },
  "dependencies": {
    "@alchemilla/medusa-razorpay": "^0.1.0",
    "@medusajs/admin-sdk": "2.17.2",
    "@medusajs/admin-shared": "2.17.2",
    "@medusajs/caching": "2.17.2",
    "@medusajs/cli": "2.17.2",
    "@medusajs/dashboard": "2.17.2",
    "@medusajs/draft-order": "2.17.2",
    "@medusajs/framework": "2.17.2",
    "@medusajs/medusa": "2.17.2",
    "@medusajs/ui": "4.1.19",
    "@tanstack/react-query": "5.64.2",
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-aria": "3.50.0",
    "react-dom": "^18.3.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.17.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-aria": "3.50.0"
  },
  "resolutions": {
    "react-aria": "3.50.0"
  }
}
